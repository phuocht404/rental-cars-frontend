# URL công khai của website (dùng cho canonical, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend NestJS. Trình duyệt gọi qua /api/v1 (rewrite cùng origin), server component gọi thẳng API_URL.
# Lưu ý: rewrite được tính lúc build, đổi API_URL cần build lại.
API_URL=http://localhost:8080
# Trùng với INTERNAL_API_KEY của backend (chỉ dùng ở server, không lộ ra trình duyệt)
API_INTERNAL_KEY=change-me-internal

# Cloudinary (upload ảnh xe trực tiếp từ trình duyệt bằng unsigned preset)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
